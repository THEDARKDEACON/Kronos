# Kronos environment — copy to .env and fill in values.
# Validate with: python3 scripts/validate_env.py

# Pipeline mode: dry | paper | live
KRONOS_MODE=dry

# Signal / portfolio toggles
USE_ENSEMBLE=true
USE_KELLY=true
LONG_ONLY=false
UNIVERSE_LIMIT=

# Rebalance schedule (production runner)
REBALANCE_FREQUENCY=weekly
REBALANCE_TIME=09:30

# Kronos model size: small | base | large
MODEL_SIZE=small

# Alpaca (paper trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# News sentiment (either key name works)
NEWSAPI_KEY=
# NEWS_API_KEY=

# Macro data (optional)
FRED_API_KEY=

# Alerts (optional — regenerate if you get HTTP 404)
SLACK_WEBHOOK_URL=

# Flask web UI debug (0 = production)
FLASK_DEBUG=0

# Run model integration tests: RUN_MODEL_TESTS=1 pytest
